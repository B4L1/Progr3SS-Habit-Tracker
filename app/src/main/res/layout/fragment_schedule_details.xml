<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/dark_blue_bg"
    tools:context=".ui.schedule.ScheduleDetailsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:paddingTop="100dp">

        <!-- Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/headerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/input_field_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:layout_marginTop="56dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Icon -->
                <ImageView
                    android:id="@+id/habitIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="10dp"
                    android:src="@drawable/ic_launcher_foreground"
                    app:tint="@color/purple_200"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Habit Name -->
                <TextView
                    android:id="@+id/habitNameTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintStart_toEndOf="@id/habitIcon"
                    app:layout_constraintTop_toTopOf="@id/habitIcon"
                    app:layout_constraintEnd_toStartOf="@id/statusProgressIndicator"
                    tools:text="Run from Kraken" />

                <!-- Time Range -->
                <TextView
                    android:id="@+id/timeRangeTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintStart_toEndOf="@id/habitIcon"
                    app:layout_constraintTop_toBottomOf="@id/habitNameTextView"
                    app:layout_constraintEnd_toStartOf="@id/statusProgressIndicator"
                    tools:text="1:30 PM - 4:30 PM" />

                <!-- Status Progress (Top Right) -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/statusProgressIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:progress="75"
                    app:trackColor="#33FFFFFF"
                    app:indicatorColor="@color/purple_200"
                    app:indicatorSize="40dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/statusCheckmark"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/checkbox_on_background"
                    app:tint="@color/green_completed"
                    android:visibility="invisible"
                    app:layout_constraintStart_toStartOf="@id/statusProgressIndicator"
                    app:layout_constraintEnd_toEndOf="@id/statusProgressIndicator"
                    app:layout_constraintTop_toTopOf="@id/statusProgressIndicator"
                    app:layout_constraintBottom_toBottomOf="@id/statusProgressIndicator" />
                
                <TextView
                    android:id="@+id/progressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 30 mins"
                    android:textSize="12sp"
                    android:textColor="@color/purple_200"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/statusProgressIndicator"
                    app:layout_constraintEnd_toEndOf="@id/statusProgressIndicator"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/statusLabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Planned"
                    android:textSize="10sp"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@id/progressText"
                    app:layout_constraintEnd_toEndOf="@id/statusProgressIndicator"
                    android:gravity="end"/>


                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/headerBarrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="timeRangeTextView,statusLabelSmall" />

                <!-- Details Grid -->
                <TextView
                    android:id="@+id/lblDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Duration"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/headerBarrier"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/valDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30m"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/lblDuration"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/lblPartner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="With partner(s)"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/lblDuration"
                    app:layout_constraintStart_toStartOf="parent"/>

                <LinearLayout
                    android:id="@+id/partnerContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toTopOf="@id/lblPartner"
                    app:layout_constraintBottom_toBottomOf="@id/lblPartner"
                    app:layout_constraintEnd_toEndOf="parent">
                    
                    <!-- Partner Avatar Placeholder -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_launcher_foreground"
                        android:background="@drawable/bg_icon_circle"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/valPartner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Davy Jones"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/lblRepeat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repeat"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/lblPartner"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/valRepeat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="recurring"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/lblRepeat"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Notes Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/notesCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/input_field_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/headerCard">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/notesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notes"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/notesContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#252538" 
                    android:padding="12dp"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/notesTitle"
                    tools:text="Kraken is a sea monster..."/>

                <TextView
                    android:id="@+id/editNotesButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit Notes"
                    android:textColor="@color/purple_200"
                    android:textStyle="bold"
                    android:drawableStart="@android:drawable/ic_menu_edit"
                    android:drawableTint="@color/purple_200"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/notesContent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recent Activity Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/historyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/input_field_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="80dp"
            app:layout_constraintTop_toBottomOf="@id/notesCard"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/historyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Activity"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/historyRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintTop_toBottomOf="@id/historyTitle"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        
        <!-- Toolbar elements overlay (back and menu) -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_circle"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="0dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Schedule Details"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:layout_constraintStart_toEndOf="@id/backButton"
            app:layout_constraintTop_toTopOf="@id/backButton"
            app:layout_constraintBottom_toBottomOf="@id/backButton"
            android:layout_marginStart="16dp"/>

        <ImageButton
            android:id="@+id/optionsMenuButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_circle"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="0dp"/>
            
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/addProgressFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_edit"
            app:backgroundTint="@color/button_color"
            app:tint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="80dp"
            app:elevation="6dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>